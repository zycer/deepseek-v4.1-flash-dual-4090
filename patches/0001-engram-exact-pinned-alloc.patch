+def _exact_pinned(numel: int, dtype: torch.dtype, keepalive: list) -> torch.Tensor:
+    """Allocate exactly `numel` elements of UVA-mapped pinned host memory.
+
+    torch's pinned allocator rounds every request up to the next power of two.
+    A 11.44 GiB Engram shard therefore reserves 16 GiB, and with 8 TP ranks x 2
+    Engram layers that waste (~73 GiB) overflows a 256 GiB host. Raw
+    cudaHostAlloc is exact and the result is still UVA addressable, so the
+    Triton lookup kernel can read it straight from the GPU.
+    """
+    global _CUDART
+    import ctypes
+
+    if _CUDART is None:
+        _CUDART = ctypes.CDLL("libcudart.so")
+    nbytes = numel * dtype.itemsize
+    ptr = ctypes.c_void_p()
+    rc = _CUDART.cudaHostAlloc(
+        ctypes.byref(ptr), ctypes.c_size_t(nbytes), ctypes.c_uint(0)
+    )
+    if rc != 0:
+        raise RuntimeError(f"cudaHostAlloc({nbytes}) failed with rc={rc}")
+    buf = (ctypes.c_char * nbytes).from_address(ptr.value)
+    # Keep the ctypes buffer alive for the whole lifetime of the parameter;
+    # dropping it would let CPython free memory the tensor still points at.
+    keepalive.append(buf)
+    keepalive.append(ptr)
+    return torch.frombuffer(buf, dtype=torch.uint8).view(dtype)
+
